# omv-mcp config template. `omv-mcp setup` writes the real one for you at:
#   Windows:     %APPDATA%\omv-mcp\config.env
#   macOS/Linux: ~/.config/omv-mcp/config.env
# (A legacy .env next to a source checkout on the NAS still works for Mode A.)
# Real environment variables override every key below.

# --- Mode B (server runs on YOUR machine, reaches the NAS over SSH) ---------
# Leave OMV_HOST empty/unset for Mode A (server runs ON the NAS).
OMV_HOST=
OMV_SSH_USER=root
OMV_SSH_PORT=22
# Optional explicit private key; default is ssh-agent, then ~/.ssh keys.
OMV_SSH_KEY=

# --- Portainer (only the stack tools need this) ------------------------------
# PORTAINER_URL empty = auto: localhost:9000 in Mode A, SSH tunnel in Mode B.
PORTAINER_URL=
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=1
