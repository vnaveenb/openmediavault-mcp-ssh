# Copy to `.env` ON THE NAS (never commit / never scp the real one).
# The server runs on the NAS as root, so omv-rpc / docker / df need no credentials.
# The ONLY secret it needs is the Portainer API key (for the stack tools).

PORTAINER_URL=http://localhost:9000/api
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=1
